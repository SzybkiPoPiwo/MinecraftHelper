<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MinecraftHelper.AutoClicker</AssemblyName>
    <RootNamespace>MinecraftHelper</RootNamespace>
    <Product>Minecraft Helper Auto Clicker</Product>
    <ApplicationIcon>..\MinecraftHelper\Assets\autoclicker.ico</ApplicationIcon>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <InformationalVersion>2.0.1-autoclicker</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MinecraftHelper\MainWindow.AutoArmor.cs" Link="Features\MainWindow.AutoArmor.cs" />
    <Compile Include="..\MinecraftHelper\MainWindow.AutoWater.cs" Link="Features\MainWindow.AutoWater.cs" />
    <Compile Include="..\MinecraftHelper\BindConflictDialogWindow.cs" Link="Windows\BindConflictDialogWindow.cs" />
    <Compile Include="..\MinecraftHelper\ReleaseNotesCatalog.cs" Link="ReleaseNotesCatalog.cs" />
    <Compile Include="..\MinecraftHelper\Services\NativeInput.cs" Link="Services\NativeInput.cs" />
    <Compile Include="..\MinecraftHelper\Services\UpdateCheckService.cs" Link="Services\UpdateCheckService.cs" />
    <Compile Include="..\MinecraftHelper\OverlayHudWindow.cs" Link="OverlayHudWindow.cs" />
    <Compile Include="..\MinecraftHelper\UpdateAvailableWindow.cs" Link="Windows\UpdateAvailableWindow.cs" />
    <Page Include="..\MinecraftHelper\Themes\ScrollBarStyles.xaml" Link="Themes\ScrollBarStyles.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\MinecraftHelper\Assets\autoclicker.ico" Link="Assets\autoclicker.ico" />
  </ItemGroup>

</Project>

