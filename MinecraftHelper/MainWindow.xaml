<Window x:Class="MinecraftHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MinecraftHelper"
        mc:Ignorable="d"
        Title="Minecraft Helper 1.1.4"
        Width="1280"
        Height="820"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Icon="Assets/app.ico"
        Background="#0F141D" Foreground="#E8EEF8">

    <Window.Resources>
        <!-- ========================================== -->
        <!-- KLUCZOWE ZASOBY DLA KODU C# (NIE USUWAĆ) -->
        <!-- ========================================== -->
        <SolidColorBrush x:Key="TileBg" Color="#1E2A39"/>
        <SolidColorBrush x:Key="TileBgActive" Color="#17324A"/>
        <SolidColorBrush x:Key="TileBorder" Color="#3E536E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2EA8FF"/>

        <!-- ===== DARK COMBOBOX (działa + ciemny hover/selected) ===== -->
        <SolidColorBrush x:Key="ComboBg" Color="#161F2B"/>
        <SolidColorBrush x:Key="ComboBorder" Color="#4B6283"/>
        <SolidColorBrush x:Key="ComboDropBg" Color="#0F141D"/>
        <SolidColorBrush x:Key="ComboHoverBg" Color="#1E2A39"/>
        <SolidColorBrush x:Key="ComboSelectedBg" Color="#2C3A4F"/>
        <SolidColorBrush x:Key="ComboText" Color="#F8FBFF"/>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ComboText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboSelectedBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7085A3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ComboText}"/>
            <Setter Property="Background" Value="{StaticResource ComboBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ComboBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- KLIKALNY toggle (żeby dropdown się otwierał) -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{StaticResource ComboText}"
                                          TextElement.Foreground="{StaticResource ComboText}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1E2A39"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7085A3"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#2C3A4F"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7F94B2"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1E2A39"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#7F94B2"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.55"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="8,0,6,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#CFDBEB"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource ComboDropBg}"
                                        BorderBrush="{StaticResource ComboBorder}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#243244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Setter Property="Padding" Value="5"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1A2432"/>
                    <Setter Property="Foreground" Value="#92A6C1"/>
                    <Setter Property="BorderBrush" Value="#34465E"/>
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Styl dla Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2B3C52"/>
                    <Setter Property="Foreground" Value="#92A6C1"/>
                    <Setter Property="Opacity" Value="0.6"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MacroInfoButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Background" Value="#1F3348"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#7FC8FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InfoBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InfoBorder" Property="Background" Value="#2A425D"/>
                                <Setter TargetName="InfoBorder" Property="BorderBrush" Value="#7FC8FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InfoBorder" Property="Background" Value="#172638"/>
                                <Setter TargetName="InfoBorder" Property="BorderBrush" Value="#7FC8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacroInfoToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#101B2A"/>
            <Setter Property="Foreground" Value="#DCE8F7"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MaxWidth" Value="420"/>
            <Setter Property="Placement" Value="Mouse"/>
            <Setter Property="HorizontalOffset" Value="14"/>
            <Setter Property="VerticalOffset" Value="14"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SlotGridCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#1E2A39"/>
            <Setter Property="BorderBrush" Value="#3E536E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#D8E2F0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SlotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SlotBorder" Property="Background" Value="#24364A"/>
                                <Setter TargetName="SlotBorder" Property="BorderBrush" Value="#5E7A9F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SlotBorder" Property="Background" Value="#102A40"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Styl dla TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFDBEB"/>
        </Style>

        <!-- Styl dla ComboBox (bazowy) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#243244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.7"/>
                    <Setter Property="Foreground" Value="#92A6C1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Kompaktowe zakładki używane wewnątrz sekcji, z pełną ramką nagłówka. -->
        <Style x:Key="SectionTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#92A6C1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="TabHeaderBorder"
                                    Background="#1E2A39"
                                    BorderBrush="#34465E"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#263A50"/>
                                <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="#6A8CB5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeaderBorder" Property="Background" Value="#152437"/>
                                <Setter TargetName="TabHeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabHeaderBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Panel.ZIndex" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="#121C29"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SectionTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- TabPanel odejmuje marginesy nagłówków podczas układania,
                                 przycinając prawą krawędź. WrapPanel rezerwuje cały rozmiar. -->
                            <WrapPanel Grid.Row="0"
                                       Orientation="Horizontal"
                                       Margin="0,0,0,6"
                                       Panel.ZIndex="1"
                                       IsItemsHost="True"
                                       KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            <Border x:Name="TabContentBorder"
                                    Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="10"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabContentBorder" Property="BorderBrush" Value="#5B789D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabContentBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KopaczChannelTabItemStyle"
               TargetType="TabItem"
               BasedOn="{StaticResource SectionTabItemStyle}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <!-- Wspólny wygląd tytułów głównych, rozwijanych sekcji -->
        <Style x:Key="MainSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#7FC8FF"/>
        </Style>

        <!-- Styl dla ramek sekcji -->
        <Style TargetType="Border" x:Key="SectionBorderStyle">
            <Setter Property="Background" Value="#151F2C"/>
            <Setter Property="BorderBrush" Value="#465D7A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#58769B"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2EA8FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <local:CyberMeshBackground x:Name="CyberBackground"
                                   IsAnimationEnabled="True"
                                   Panel.ZIndex="0"/>

        <DockPanel Background="Transparent" Panel.ZIndex="1">

        <!-- STATUS BAR (GÓRA) -->
        <Border DockPanel.Dock="Top" Background="#1E2A39" BorderBrush="#34465E" BorderThickness="0,0,0,1">
            <TextBlock Name="TxtStatusBar"
                       Text="Gotowy"
                       Margin="12,6"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#38D6B4"/>
        </Border>

        <!-- PANEL GŁÓWNY (NAZWA OKNA + STATUSY) -->
        <Border DockPanel.Dock="Top" Background="#161F2B" BorderBrush="#34465E" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Wiersz 1: Nazwa Okna -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📌 NAZWA OKNA:" FontSize="12" FontWeight="Bold" Foreground="#A8BAD3" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <Border Grid.Column="1" Background="#243244" BorderBrush="#4B6283" BorderThickness="1" Padding="8" CornerRadius="3">
                        <TextBlock Name="TxtCurrentWindowTitle"
                                   Text="Brak"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#7FC8FF"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Wiersz 3: Kafelki Statusów -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <Style TargetType="Border" x:Key="TileStyle">
                            <Setter Property="Background" Value="{StaticResource TileBg}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TileBorder}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="CornerRadius" Value="3"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="TileHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="#E8EEF8"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                        <Style TargetType="TextBlock" x:Key="TileValue">
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Foreground" Value="#92A6C1"/>
                        </Style>
                    </Grid.Resources>

                    <Border Name="BorderManualStatus" Grid.Column="0" Style="{StaticResource TileStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="LPM + PPM" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtManualCps"
                                       Text="CPS: Wyłączony"
                                       Style="{StaticResource TileValue}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <Border Name="BorderAutoLeftStatus" Grid.Column="1" Style="{StaticResource TileStyle}">
                        <StackPanel>
                            <TextBlock Text="AUTO LPM" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtAutoLeftCps"
                                       Text="CPS: Wyłączony"
                                       Style="{StaticResource TileValue}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <Border Name="BorderAutoRightStatus" Grid.Column="2" Style="{StaticResource TileStyle}">
                        <StackPanel>
                            <TextBlock Text="AUTO PPM" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtAutoRightCps"
                                       Text="CPS: Wyłączony"
                                       Style="{StaticResource TileValue}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <Border Name="BorderKopacz533Status" Grid.Column="3" Style="{StaticResource TileStyle}">
                        <StackPanel>
                            <TextBlock Text="KOPACZ 5/3/3" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtKopacz533Status"
                                       Text="Wyłączony"
                                       Style="{StaticResource TileValue}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <Border Name="BorderKopacz633Status" Grid.Column="4" Style="{StaticResource TileStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="KOPACZ 6/3/3" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtKopacz633Status"
                                       Text="Wyłączony"
                                       Style="{StaticResource TileValue}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <Border Name="BorderJablkaZLisciStatus" Grid.Column="5" Style="{StaticResource TileStyle}">
                        <StackPanel>
                            <TextBlock Text="Jabłka z liści" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtJablkaZLisciStatus"
                                       Text="Wyłączony"
                                       Style="{StaticResource TileValue}"
                                       TextWrapping="Wrap"
                                       LineStackingStrategy="BlockLineHeight"
                                       LineHeight="14"/>
                        </StackPanel>
                    </Border>

                    <Border Name="BorderCursorPauseStatus" Grid.Column="6" Style="{StaticResource TileStyle}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Pauza ekwipunku" Style="{StaticResource TileHeader}"/>
                            <TextBlock Name="TxtCursorPauseStatus" Text="Wyłączona" Style="{StaticResource TileValue}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- STATUS FOCUS/ZAPIS (Środkowy pasek) -->
        <Border DockPanel.Dock="Top" Background="#0F141D" BorderBrush="#34465E" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,34,0">
                    <Ellipse Name="EllMinecraftFocus" Width="10" Height="10" Fill="#FF6B6B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Minecraft Focus:" Width="120" Foreground="#CFDBEB"/>
                    <TextBlock Name="TxtMinecraftFocus" Text="✗ Nie" FontWeight="Bold" Foreground="#FF6B6B"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
