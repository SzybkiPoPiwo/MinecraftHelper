                                                             Width="340"
                                                             TextChanged="TxtTestAutoFishingRepairConfig_TextChanged"/>
                                                    <TextBlock Text=" Co X sek:" Margin="10,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBox Name="TxtTestAutoFishingRepairEverySeconds"
                                                             Width="80"
                                                             TextChanged="TxtTestAutoFishingRepairConfig_TextChanged"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="Min -> sek:" Width="170" VerticalAlignment="Center"/>
                                                    <TextBox Name="TxtTestAutoFishingMinutesToSecondsInput"
                                                             Width="100"
                                                             Margin="0,0,10,0"
                                                             TextChanged="TxtTestAutoFishingMinutesToSecondsInput_TextChanged"/>
                                                    <TextBlock Name="TxtTestAutoFishingMinutesToSecondsOutput"
                                                               Text="np. 3 min = 180 s"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Foreground="#92A6C1"/>
                                                </StackPanel>

                                                <TextBlock Name="TxtTestAutoFishingAreaInfo"
                                                           Text="Brak obszaru monitoringu spławika. Kliknij &quot;Zaznacz obszar&quot;."
                                                           Margin="0,0,0,8"
                                                           FontSize="11"
                                                           Foreground="#92A6C1"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="0 sekund = wyłączone. Gdy komenda się wykona, makro ponownie zarzuci wędkę i wróci do monitoringu."
                                                           FontSize="11"
                                                           Margin="0,0,0,8"
                                                           Foreground="#92A6C1"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Status spławika:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Name="TxtTestAutoFishingState"
                                                               Text="-"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="#7FC8FF"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="#101722"
                                                    BorderBrush="#4B6283"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8"
                                                    VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="Podgląd obszaru"
                                                               Margin="0,0,0,6"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#7FC8FF"/>
                                                    <Border Background="#0B121D"
                                                            BorderBrush="#26384F"
                                                            BorderThickness="1"
                                                            Height="125">
                                                        <Image Name="ImgTestAutoFishingPreview" Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Name="TxtTestAutoFishingPreviewInfo"
                                                               Text="Brak zaznaczonego obszaru."
                                                               Margin="0,6,0,0"
                                                               FontSize="10"
                                                               Foreground="#92A6C1"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========== USTAWIENIA ========== -->
            <TabItem Header="Ustawienia">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Ogólne ustawienia"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="#7FC8FF"/>
                                <Button Content="?"
                                        Style="{StaticResource MacroInfoButtonStyle}"
                                        Margin="8,0,0,0"
                                        ToolTipService.InitialShowDelay="100"
                                        ToolTipService.ShowDuration="120000">
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource MacroInfoToolTipStyle}"
                                                 MaxWidth="520"
                                                 Content="JAK SKONFIGUROWAĆ PROGRAM:&#10;1. Uruchom Minecrafta i wejdź do gry.&#10;2. Kliknij Odśwież przy polu Program gry.&#10;3. Wybierz proces właściwego okna Minecrafta lub BlazingPacka — nie wybieraj launchera.&#10;4. Kliknij Zapisz program. Górny wskaźnik Minecraft Focus zmieni się na zielony, gdy aktywne jest właściwe okno gry.&#10;&#10;HUD (OVERLAY):&#10;Wyświetla na ekranie stan clickerów, kopacza, Auto EQ i CobbleX. Możesz wybrać monitor, narożnik oraz wyłączyć animacje HUD.&#10;&#10;IMPORT / EXPORT:&#10;Exportuj zapisuje pełną konfigurację do pliku JSON. Importuj wczytuje taki plik i ustawia go jako aktywną konfigurację. Program zapisuje bieżące ustawienia automatycznie w %APPDATA%\Minecraft Helper\settings.json."/>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,25">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Program gry:" Width="140" VerticalAlignment="Center"/>
                                    <ComboBox Name="CbTargetProcessList"
                                              Width="380"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="CbTargetProcessList_SelectionChanged"/>
                                    <Button Name="BtnRefreshTargetProcessList"
                                            Content="Odśwież"
                                            Width="90"
                                            Margin="10,0,0,0"
                                            Click="BtnRefreshTargetProcessList_Click"/>
                                    <Button Name="BtnSaveTargetWindowTitle"
                                            Content="Zapisz program"
                                            Width="130"
                                            Margin="10,0,0,0"
                                            Click="BtnSaveTargetWindowTitle_Click"/>
                                </StackPanel>
                                <TextBox Name="TxtTargetWindowTitle"
                                         Width="300"
                                         Visibility="Collapsed"/>
                            </StackPanel>

                            <Border Style="{StaticResource SectionBorderStyle}"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Sterowanie Minecrafta dla automatyzacji"
                                                   Style="{StaticResource MainSectionHeaderTextStyle}"/>
                                        <Button Content="?"
                                                Style="{StaticResource MacroInfoButtonStyle}"
                                                Margin="8,0,0,0"
                                                ToolTipService.InitialShowDelay="100"
                                                ToolTipService.ShowDuration="120000">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource MacroInfoToolTipStyle}"
                                                         MaxWidth="500"
                                                         Content="Ustaw takie same klawisze jak w sterowaniu Minecrafta. Klawisz otwierania chatu jest używany przez wszystkie automatycznie wpisywane komendy. Klawisz wyrzucania jest używany przez Auto EQ razem z lewym Ctrl, aby wyrzucać całe stosy. Domyślnie: T dla chatu i Q dla wyrzucania."/>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Otwieranie chatu:" Width="160" VerticalAlignment="Center"/>
                                        <TextBox Name="TxtChatOpenKey"
                                                 Width="90"
                                                 Margin="0,0,10,0"
                                                 IsReadOnly="True"
                                                 FontWeight="Bold"
                                                 Foreground="#38D6B4"
                                                 Tag="ChatOpen"
                                                 PreviewMouseLeftButtonDown="BindKeyBox_PreviewMouseLeftButtonDown"/>
                                        <Button Name="BtnChatOpenKeySave"
                                                Content="Zapisz"
                                                Width="90"
                                                Click="BtnChatOpenKeySave_Click"/>
                                        <Button Content="Domyślny T"
                                                Width="105"
                                                Margin="10,0,0,0"
                                                Tag="ChatOpen"
                                                Click="BtnResetMinecraftControlKey_Click"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Wyrzucanie przedmiotu:" Width="160" VerticalAlignment="Center"/>
                                        <TextBox Name="TxtDropItemKey"
                                                 Width="90"
                                                 Margin="0,0,10,0"
                                                 IsReadOnly="True"
                                                 FontWeight="Bold"
                                                 Foreground="#38D6B4"
                                                 Tag="DropItem"
                                                 PreviewMouseLeftButtonDown="BindKeyBox_PreviewMouseLeftButtonDown"/>
                                        <Button Name="BtnDropItemKeySave"
                                                Content="Zapisz"
                                                Width="90"
                                                Click="BtnDropItemKeySave_Click"/>
                                        <Button Content="Domyślny Q"
                                                Width="105"
                                                Margin="10,0,0,0"
                                                Tag="DropItem"
                                                Click="BtnResetMinecraftControlKey_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="Kliknij pole, naciśnij klawisz z ustawień Minecrafta i wybierz Zapisz."
                                               Margin="0,10,0,0"
                                               FontSize="10"
                                               Foreground="#92A6C1"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionBorderStyle}"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Name="ChkAnimatedBackgroundEnabled"
                                                  VerticalAlignment="Center"
                                                  Checked="ChkAnimatedBackgroundEnabled_Changed"
                                                  Unchecked="ChkAnimatedBackgroundEnabled_Changed"/>
                                        <TextBlock Text="Animowane tło gwiazd"
                                                   Style="{StaticResource MainSectionHeaderTextStyle}"/>
                                        <Button Content="?"
                                                Style="{StaticResource MacroInfoButtonStyle}"
                                                Margin="8,0,0,0"
                                                ToolTipService.InitialShowDelay="100"
                                                ToolTipService.ShowDuration="120000">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource MacroInfoToolTipStyle}"
                                                         MaxWidth="460"
                                                         Content="Włącza panoramiczne pole drobnych, kolorowych gwiazd z migoczącymi rozbłyskami i delikatnymi spadającymi punktami. Animacja działa z ograniczeniem do 15 FPS i zatrzymuje się po zminimalizowaniu albo ukryciu aplikacji w zasobniku."/>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Panoramiczne tło z lekkimi spadającymi gwiazdami; pauza po ukryciu."
                                               Margin="28,8,0,0"
                                               FontSize="10"
                                               Foreground="#92A6C1"/>
                                </StackPanel>
                            </Border>

                            <Border Name="BorderOverlayHudSection"
                                    Style="{StaticResource SectionBorderStyle}"
                                    Margin="0,0,0,24">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Name="ChkOverlayHudEnabled"
                                                  VerticalAlignment="Center"
                                                  Checked="ChkOverlaySettings_Changed"
                                                  Unchecked="ChkOverlaySettings_Changed"/>
                                        <TextBlock Text="Panel HUD (overlay)"
                                                   Style="{StaticResource MainSectionHeaderTextStyle}"/>
                                        <Button Content="?"
                                                Style="{StaticResource MacroInfoButtonStyle}"
                                                Margin="8,0,0,0"
                                                ToolTipService.InitialShowDelay="100"
                                                ToolTipService.ShowDuration="120000">
                                            <Button.ToolTip>
                                                <ToolTip Style="{StaticResource MacroInfoToolTipStyle}"
                                                         Content="HUD to mały panel informacyjny wyświetlany nad grą. Pokazuje aktywne makra, bindy, CPS oraz stan Auto EQ i CobbleX. Po włączeniu wybierz monitor i narożnik ekranu. Opcja Animacje HUD odpowiada tylko za animowane pojawianie się panelu — jej wyłączenie nie wyłącza samego HUD."/>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Name="PanelOverlayHudContent"
                                                Margin="0,12,0,0"
                                                Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <CheckBox Name="ChkOverlayAnimationsEnabled"
                                                  VerticalAlignment="Center"
                                                  Checked="ChkOverlaySettings_Changed"
                                                  Unchecked="ChkOverlaySettings_Changed"/>
                                        <TextBlock Text="Animacje HUD"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Monitor:" Width="140" VerticalAlignment="Center"/>
                                        <ComboBox Name="CbOverlayMonitor"
                                                  Width="300"
                                                  Style="{StaticResource DarkComboBox}"
                                                  SelectionChanged="CbOverlayMonitor_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Pozycja:" Width="140" VerticalAlignment="Center"/>
                                        <ComboBox Name="CbOverlayCorner"
                                                  Width="220"
                                                  Style="{StaticResource DarkComboBox}"
                                                  SelectionChanged="CbOverlayCorner_SelectionChanged">
                                            <ComboBoxItem>Prawy dolny</ComboBoxItem>
                                            <ComboBoxItem>Lewy dolny</ComboBoxItem>
                                            <ComboBoxItem>Prawy górny</ComboBoxItem>
                                            <ComboBoxItem>Lewy górny</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Import/Export ustawień"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="#7FC8FF"/>
                                <Button Content="?"
                                        Style="{StaticResource MacroInfoButtonStyle}"
                                        Margin="8,0,0,0"
                                        ToolTipService.InitialShowDelay="100"
                                        ToolTipService.ShowDuration="120000">
                                    <Button.ToolTip>
                                        <ToolTip Style="{StaticResource MacroInfoToolTipStyle}"
                                                 MaxWidth="480"
                                                 Content="Exportuj tworzy plik JSON z pełną konfiguracją programu: bindami, CPS, kopaczem, Auto EQ, CobbleX i HUD. Importuj wczytuje wskazany plik, sprawdza jego ustawienia i zapisuje je jako aktywne. Bieżąca konfiguracja jest również automatycznie zapisywana w %APPDATA%\Minecraft Helper\settings.json."/>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Name="BtnExportSettings" Content="💾 Exportuj" Width="120" Height="35" Click="BtnExportSettings_Click" Margin="0,0,15,0"/>
                                <Button Name="BtnImportSettings" Content="📂 Importuj" Width="120" Height="35" Click="BtnImportSettings_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#161F2B" BorderBrush="#4B6283" BorderThickness="1" Padding="20" CornerRadius="4" Margin="20,0,0,0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="👨‍💻 Autor" FontSize="13" FontWeight="Bold" Margin="0,0,0,15" Foreground="#7FC8FF"/>

                                <TextBlock Text="SzybkiPoPiwo" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="🔗 Github:" FontSize="11" FontWeight="Bold" Foreground="#CFDBEB"/>
                                <TextBlock FontSize="11" Margin="0,0,0,10">
                                    <Hyperlink NavigateUri="https://github.com/SzybkiPoPiwo" RequestNavigate="Github_RequestNavigate" Foreground="#2EA8FF">
                                        https://github.com/SzybkiPoPiwo
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock Text="💬 Discord:" FontSize="11" FontWeight="Bold" Foreground="#CFDBEB"/>
                                <TextBox Text="twojstaryricardo"
                         FontSize="11"
                         Foreground="#97AEFF"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         IsReadOnlyCaretVisible="False"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>
</Window>
