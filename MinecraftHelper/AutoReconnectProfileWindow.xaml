<Window x:Class="MinecraftHelper.AutoReconnectProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Profil Auto Reconnect"
        Width="760"
        Height="820"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F141D"
        Foreground="#E8EEF8">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CFDBEB"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#243244"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#2EA8FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B6283"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.68"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EEF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="#141E2B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#2F425B"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="36">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Margin="2"
                                                        Background="#355171"
                                                        CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#46658A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#5A7DA8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#4B6283" BorderThickness="1" Background="#0F141D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1E2A39"
                    BorderBrush="#34465E"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0">
                    <TextBlock Text="Konfiguracja serwera Auto Reconnect"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#7FC8FF"/>
                    <Button Content="✕"
                            Width="34"
                            Height="28"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Background="#512433"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,16">
                    <TextBlock Text="Podstawowe informacje"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#7FC8FF"
                               Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nazwa profilu:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtProfileName" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Adres Direct Connect:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtServerAddress" Grid.Column="1"/>
                    </Grid>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Komenda domu:" VerticalAlignment="Center"/>
                        <TextBox Name="TxtHomeCommand" Grid.Column="1"/>
                    </Grid>
                    <TextBlock Text="Bez GUI wpisz pełną komendę, np. /home kopalnia."
                               FontSize="10.5"
                               Foreground="#92A6C1"
                               Margin="185,0,0,14"/>

                    <Border Background="#161F2B"
                            BorderBrush="#4B6283"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Powrót po pełnym reconnectcie"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#7FC8FF"
                                       Margin="0,0,0,9"/>
                            <CheckBox Name="ChkHomeHasGui"
                                      Content="Komenda /home otwiera GUI z wyborem"
                                      Checked="ChkHomeHasGui_Changed"
                                      Unchecked="ChkHomeHasGui_Changed"/>

                            <StackPanel Name="PanelHomeGui" Margin="0,14,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Czekaj na GUI (s):" VerticalAlignment="Center"/>
                                    <TextBox Name="TxtHomeGuiDelay" Grid.Column="1"/>
                                    <TextBlock Grid.Column="2"
                                               Text="czas od wysłania /home"
                                               VerticalAlignment="Center"
                                               Foreground="#92A6C1"
                                               Margin="10,0,0,0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Pole do kliknięcia:"
                                               FontWeight="Bold"
                                               Foreground="#A8BAD3"/>
                                    <TextBlock Name="TxtSelectedSlot"
                                               Margin="8,0,0,0"
                                               FontWeight="Bold"
                                               Foreground="#38D6B4"/>
                                </StackPanel>
                                <TextBlock Text="Kliknij slot. Przyciski + z prawej i na dole rozszerzają planszę."
                                           FontSize="10.5"
                                           Foreground="#92A6C1"
                                           Margin="0,0,0,8"/>

                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>

                                    <Border Name="BorderHomeSlots"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Background="#101722"
                                            BorderBrush="#4B6283"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5">
                                        <UniformGrid Name="PanelHomeSlots"/>
                                    </Border>

                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="+ Kolumna"
                                                Background="#1E405A"
                                                Margin="0,0,0,6"
                                                Click="BtnAddColumn_Click"/>
                                        <Button Content="− Kolumna"
                                                Background="#243244"
                                                Click="BtnRemoveColumn_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Button Content="+ Rząd"
                                                Width="105"
                                                Background="#1E405A"
                                                Margin="0,0,8,0"
                                                Click="BtnAddRow_Click"/>
                                        <Button Content="− Rząd"
                                                Width="105"
                                                Background="#243244"
                                                Click="BtnRemoveRow_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Name="TxtGridSize"
                                           FontSize="10"
                                           Foreground="#7FC8FF"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#161F2B"
                            BorderBrush="#4B6283"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox Name="ChkMissingPickaxeRecovery"
                                      Content="Podczas Auto EQ: brak diamentowego kilofa = wróć do home i zakończ kopanie"
                                      Checked="ChkMissingPickaxeRecovery_Changed"
                                      Unchecked="ChkMissingPickaxeRecovery_Changed"/>
                            <TextBlock Text="Kontrola działa wyłącznie podczas zaplanowanego wyrzucania przedmiotów. Nie otwiera dodatkowo EQ. Program sprawdza 27 slotów oraz hotbar."
                                       FontSize="10.5"
                                       Foreground="#92A6C1"
                                       TextWrapping="Wrap"
                                       Margin="24,7,0,0"/>

                            <StackPanel Name="PanelMissingPickaxeRecovery" Margin="24,14,0,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Komenda powrotu:" VerticalAlignment="Center"/>
                                    <TextBox Name="TxtMissingPickaxeHomeCommand" Grid.Column="1"/>
                                </Grid>
                                <TextBlock Text="Bez GUI wpisz pełną komendę, np. /home kopalnia. To ustawienie jest niezależne od powrotu po reconnectcie."
                                           FontSize="10.5"
                                           Foreground="#92A6C1"
                                           TextWrapping="Wrap"
                                           Margin="185,-2,0,12"/>

                                <CheckBox Name="ChkMissingPickaxeHomeHasGui"
                                          Content="Komenda powrotu otwiera GUI z wyborem"
                                          Checked="ChkMissingPickaxeHomeHasGui_Changed"
                                          Unchecked="ChkMissingPickaxeHomeHasGui_Changed"/>

                                <StackPanel Name="PanelMissingPickaxeHomeGui" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="185"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Czekaj na GUI (s):" VerticalAlignment="Center"/>
                                        <TextBox Name="TxtMissingPickaxeHomeGuiDelay" Grid.Column="1"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="czas od wysłania komendy"
                                                   VerticalAlignment="Center"
                                                   Foreground="#92A6C1"
                                                   Margin="10,0,0,0"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Pole do kliknięcia:"
                                                   FontWeight="Bold"
                                                   Foreground="#A8BAD3"/>
                                        <TextBlock Name="TxtMissingPickaxeSelectedSlot"
                                                   Margin="8,0,0,0"
                                                   FontWeight="Bold"
                                                   Foreground="#38D6B4"/>
                                    </StackPanel>
                                    <TextBlock Text="Kliknij slot używany wyłącznie po wykryciu braku diamentowego kilofa."
                                               FontSize="10.5"
                                               Foreground="#92A6C1"
                                               Margin="0,0,0,8"/>

                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="42"/>
                                        </Grid.RowDefinitions>

                                        <Border Name="BorderMissingPickaxeHomeSlots"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Background="#101722"
                                                BorderBrush="#4B6283"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="5">
                                            <UniformGrid Name="PanelMissingPickaxeHomeSlots"/>
                                        </Border>

                                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Button Content="+ Kolumna"
                                                    Background="#1E405A"
                                                    Margin="0,0,0,6"
                                                    Click="BtnMissingPickaxeAddColumn_Click"/>
                                            <Button Content="− Kolumna"
                                                    Background="#243244"
                                                    Click="BtnMissingPickaxeRemoveColumn_Click"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                            <Button Content="+ Rząd"
                                                    Width="105"
                                                    Background="#1E405A"
                                                    Margin="0,0,8,0"
                                                    Click="BtnMissingPickaxeAddRow_Click"/>
                                            <Button Content="− Rząd"
                                                    Width="105"
                                                    Background="#243244"
                                                    Click="BtnMissingPickaxeRemoveRow_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Name="TxtMissingPickaxeGridSize"
                                               FontSize="10"
                                               Foreground="#7FC8FF"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Czasy reconnectu"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#7FC8FF"
                               Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,12,9">
                            <TextBlock Text="Po dołączeniu (s):" Width="145" VerticalAlignment="Center"/>
                            <TextBox Name="TxtJoinDelay" Width="65"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <TextBlock Text="Teleport (s):" Width="130" VerticalAlignment="Center"/>
                            <TextBox Name="TxtTeleportDelay" Width="65"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <TextBlock Text="Maks. prób:" Width="130" VerticalAlignment="Center"/>
                            <TextBox Name="TxtMaxAttempts" Width="65"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Name="TxtValidation"
                               Foreground="#FF6B6B"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#161F2B"
                    BorderBrush="#34465E"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0">
                    <Button Content="Anuluj"
                            Width="105"
                            Background="#243244"
                            Margin="0,0,10,0"
                            Click="BtnCancel_Click"/>
                    <Button Content="Zapisz profil"
                            Width="130"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
